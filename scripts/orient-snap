#!/bin/zsh
# orient-snap ATOM BAR OUTDIR [extra riskell flags]
#   Snapshot one atom alone on one bar (top|bottom|left) in a second riskell instance (the live bar is not touched).
#   (Use "bottom" for horizontal checks: the top bar has the notch wings.) Writes OUTDIR/ATOM-BAR.png (cropped to the island, on a blue backdrop so transparency and spill are visible, 3x scaled).
set -e
root=${0:A:h:h}; atom=$1; bar=$2; out=$3; shift 3
mkdir -p $out; tmp=$(mktemp -d)
python3 -I - $atom $bar $tmp/layout.json <<'PY'
import json,sys
atom,bar,path=sys.argv[1:4]
e={"start":[],"center":[],"end":[]}
spec={"top":{"start":[{"id":"compat","atoms":["compat"]}],"center":[],"end":[]},"bottom":dict(e),"left":dict(e)}
spec[bar]["start" if bar=="left" else "end"]=[{"id":"t","atoms":[atom]}]
json.dump({**spec,"hugTop":False,"hugBottom":False,"hugLeft":False,"gap":8},open(path,"w"))
PY
RISKELL_ALL_FITS=1 RISKELL_LAYOUT=$tmp/layout.json $root/.build/release/riskell --no-usage --no-reserve --no-claude --fake-usage --snap $tmp --stay 4 "$@" >/dev/null 2>&1 || true
python3 -I - $tmp/$bar.png $out/$atom-$bar.png <<'PY'
import sys
from PIL import Image
src,dst=sys.argv[1:3]
im=Image.open(src).convert("RGBA")
bb=im.getchannel("A").point(lambda a:255 if a>8 else 0).getbbox()
if not bb: print("empty snapshot"); sys.exit(1)
pad=14; bb=(max(0,bb[0]-pad),max(0,bb[1]-pad),min(im.width,bb[2]+pad),min(im.height,bb[3]+pad))
bg=Image.new("RGBA",im.size,(60,60,200,255)); bg.alpha_composite(im)
bg.crop(bb).resize(((bb[2]-bb[0])*3//2*2//2*1,(bb[3]-bb[1])*3//2*2//2*1)).save(dst); print(dst)
PY
rm -rf $tmp
