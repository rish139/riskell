#!/usr/bin/env python3 -I
# Generates Sources/riskell-setup/ThemeData.swift from installer/themes.json (the same data `riskell --list-themes` prints).
# Run after editing themes.json:   python3 -I scripts/gen-installer-themes
# Standard library only. The output is committed; the installer never reads the JSON at run time.
import json
import os

root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
src = os.path.join(root, "installer", "themes.json")
dst = os.path.join(root, "Sources", "riskell-setup", "ThemeData.swift")

FIELDS = ["id", "name", "variant", "bg", "tile", "text1", "text2", "text3", "text4",
          "accent", "ok", "warn", "crit", "info"]

with open(src, encoding="utf-8") as f:
    schemes = json.load(f)

lines = [
    "// GENERATED by scripts/gen-installer-themes from installer/themes.json. Do not edit by hand.",
    "",
    "struct SchemeData {",
    "    let id, name, variant, bg, tile, text1, text2, text3, text4: String",
    "    let accent, ok, warn, crit, info: String",
    "    let isDefault: Bool",
    "}",
    "",
    "let schemeData: [SchemeData] = [",
]
for s in schemes:
    args = ", ".join('%s: "%s"' % (k, s[k]) for k in FIELDS)
    lines.append("    SchemeData(%s, isDefault: %s)," % (args, "true" if s.get("default") else "false"))
lines.append("]")
lines.append("")

with open(dst, "w", encoding="utf-8") as f:
    f.write("\n".join(lines))
print("wrote %s (%d schemes)" % (os.path.relpath(dst, root), len(schemes)))
